# Credenziali del progetto Supabase DEDICATO AI TEST (mai quello di produzione).
# Copia questo file in .env.test (già in .gitignore, come .env) e compilalo
# con le connection string del progetto di test creato su supabase.com.

DATABASE_URL="postgresql://postgres.<test-project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<test-project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# Conferma esplicita richiesta da tests/integration/setup.ts prima di eseguire
# qualunque scrittura: previene che il test parta per errore contro un DB non
# ancora verificato come "di test".
ALLOW_TENANT_INTEGRATION_TESTS=true
